#include <iostream>
using namespace std;

enum class Zone {
    Inner,
    Middle,
    Outer,
    Airport
};

long long calculateFare(Zone zone, int hour, bool weekend) {
    long long baseFare;

    switch (zone) {
        case Zone::Inner:
            baseFare = 1000;
            break;
        case Zone::Middle:
            baseFare = 2000;
            break;
        case Zone::Outer:
            baseFare = 3000;
            break;
        case Zone::Airport:
            baseFare = 6000;
            break;
        default:
            return -1;
    }

    bool peak = (hour >= 8 && hour < 10) ||
                (hour >= 17 && hour < 20);

    if (weekend) {
        baseFare = baseFare * 90 / 100;
    } else if (peak) {
        baseFare = baseFare * 120 / 100;
    }

    return baseFare;
}

class MonthlyPass {
private:
    Zone zone1;
    Zone zone2;

public:
    MonthlyPass(Zone first, Zone second) {
        zone1 = first;
        zone2 = second;
    }

    bool isCovered(Zone zone) {
        return zone == zone1 || zone == zone2;
    }
};

int main() {
    MonthlyPass pass(Zone::Inner, Zone::Middle);

    cout << "Airport fare on weekday peak: Rs."
         << calculateFare(Zone::Airport, 8, false) / 100.0
         << endl;

    cout << "Airport fare on weekend: Rs."
         << calculateFare(Zone::Airport, 12, true) / 100.0
         << endl;

    if (pass.isCovered(Zone::Inner)) {
        cout << "Inner zone covered by monthly pass" << endl;
    }

    if (!pass.isCovered(Zone::Airport)) {
        cout << "Airport zone not covered by monthly pass" << endl;
    }

    return 0;
}
