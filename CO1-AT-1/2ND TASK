#include <iostream>
using namespace std;

enum class Zone {
    Inner,
    Middle,
    Outer
};

constexpr int INNER_FARE = 1000;
constexpr int MIDDLE_FARE = 2000;
constexpr int OUTER_FARE = 3000;

int main() {
    Zone zone = Zone::Outer;

    switch (zone) {
        case Zone::Inner:
            cout << "Fare: Rs.10" << endl;
            break;

        case Zone::Middle:
            cout << "Fare: Rs.20" << endl;
            break;

        case Zone::Outer:
            cout << "Fare: Rs.30" << endl;
            break;
    }

    return 0;
}
