#include <iostream>
#include <iomanip>
using namespace std;

enum class Zone { Inner, Middle, Outer };

constexpr int BASE_PAISE[] = {1000, 2000, 3000};
constexpr int PEAK_SURCHARGE_PERCENT = 20;
constexpr long long MIN_BALANCE_PAISE = 5000;

long long fare(Zone z, bool peak) {
    int base = 0;

    switch (z) {
        case Zone::Inner:
            base = BASE_PAISE[0];
            break;

        case Zone::Middle:
            base = BASE_PAISE[1];
            break;

        case Zone::Outer:
            base = BASE_PAISE[2];
            break;
    }

    if (peak) {
        base = base + base * PEAK_SURCHARGE_PERCENT / 100;
    }

    return base;
}

bool canTravel(long long balance, long long f) {
    return balance - f >= MIN_BALANCE_PAISE;
}

int main() {
    long long balance = 10000;

    Zone zones[] = {
        Zone::Inner,
        Zone::Outer,
        Zone::Middle
    };

    bool peak[] = {false, true, false};

    for (int i = 0; i < 3; i++) {
        long long f = fare(zones[i], peak[i]);

        if (canTravel(balance, f)) {
            balance -= f;

            cout << fixed << setprecision(2);
            cout << "Fare Rs " << f / 100.0
                 << " balance Rs " << balance / 100 << endl;
        } else {
            cout << "Denied (low balance) balance Rs "
                 << balance / 100 << endl;
        }
    }

    return 0;
}
